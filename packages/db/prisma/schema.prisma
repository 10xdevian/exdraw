generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  email    String
  chats    Chat[]
  rooms    Room[]   @relation("RoomAdmin")
  editorOf Room[]   @relation("RoomEditors")
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  viewSlug  String?  @unique
  collabSlug String? @unique
  createdAt DateTime @default(now())
  adminId   Int?
  admin     User?    @relation("RoomAdmin", fields: [adminId], references: [id])
  editors   User[]   @relation("RoomEditors")
  chat      Chat[]
  viewers   Viewer[]
  snapshot  Snapshot?
}

model Chat {
  id      Int    @id @default(autoincrement())
  roomId  Int
  message String
  userId  Int?

  room Room @relation(fields: [roomId], references: [id])
  user User? @relation(fields: [userId], references: [id])
}

model Viewer {
  id      Int    @id @default(autoincrement())
  roomId  Int
  name    String
  room    Room   @relation(fields: [roomId], references: [id])
}

model Snapshot {
  id              Int      @id @default(autoincrement())
  roomId          Int      @unique
  latestSequence  Int      // The sequenceNumber of the last chat message included in this snapshot
  s3Key           String   // The object storage key for the serialized room state
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  room            Room     @relation(fields: [roomId], references: [id])
}
